---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getPosts, formatDate, readingTime } from '../../data/blog';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = new URL(`/blog/${post.id}/`, Astro.site).href;
const studio = { '@type': 'Organization', '@id': 'https://idassa.digital/#studio', name: site.name, url: 'https://idassa.digital/', logo: { '@type': 'ImageObject', url: 'https://idassa.digital/assets/icon-512.png' } };
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date.toISOString(),
      dateModified: (post.data.updated ?? post.data.date).toISOString(),
      inLanguage: 'hr',
      mainEntityOfPage: url,
      ...(post.data.image && { image: new URL(post.data.imageOg ?? post.data.image, Astro.site).href }),
      author: studio,
      publisher: studio,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Početna', item: 'https://idassa.digital/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://idassa.digital/blog/' },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
      ],
    },
  ],
};
---
<Base title={`${post.data.title} | idassa.digital`} description={post.data.description} ogType="article" ogImage={post.data.imageOg ?? post.data.image} ogImageAlt={post.data.imageAlt || post.data.title} published={post.data.date} modified={post.data.updated ?? post.data.date}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="post">
    <p class="post-back"><a href="/blog/">← Svi članci</a></p>
    <h1>{post.data.title}</h1>
    <p class="post-meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {readingTime(post.body)} min čitanja
      {post.data.updated && <> · ažurirano {formatDate(post.data.updated)}</>}
    </p>
    {post.data.image && (
      <figure class="post-cover">
        <a href={post.data.image}><img src={post.data.image} srcset={post.data.imageSmall ? `${post.data.imageSmall} 800w, ${post.data.image} 1600w` : undefined} sizes="(max-width: 760px) 100vw, 720px" alt={post.data.imageAlt} fetchpriority="high" /></a>
        {(post.data.imageCaption || post.data.imageCredit) && (
          <figcaption>
            {post.data.imageCaption}
            {post.data.imageCaption && post.data.imageCredit && ' '}
            {post.data.imageCredit && <>Foto: {post.data.imageCreditUrl ? <a href={post.data.imageCreditUrl} target="_blank" rel="noopener">{post.data.imageCredit}</a> : post.data.imageCredit}</>}
          </figcaption>
        )}
      </figure>
    )}
    <div class="prose">
      <Content />
    </div>
    <aside class="post-cta">
      <h2>Trebate web stranicu?</h2>
      <p>Napišite nam što vam treba i javljamo se u roku od jednog radnog dana s prijedlogom i cijenom, bez obveze.</p>
      <a class="btn sun" href="/#kontakt">Zatraži ponudu</a>
    </aside>
  </article>
</Base>
