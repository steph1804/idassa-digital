---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { portfolio } from '../data/portfolio';
const shots = portfolio.filter((w) => w.image);

const faq = [
  { q: 'Koliko traje izrada stranice?', a: 'Jednostavna stranica gotova je za oko dva tjedna od prvog razgovora. Veće stranice s više podstranica traju tri do četiri tjedna, ovisno o sadržaju.' },
  { q: 'Koliko košta web stranica?', a: 'Paket Portus (stranica na jednoj stranici, 3 jezika, registracija domene) košta 390 €, a paket Forum (do 6 podstranica, tekstovi, osnovni SEO i Google profil, 7 jezika) 790 €. Cijene su konačne i jednokratne. Održavanje i hosting su od 25 € mjesečno.' },
  { q: 'Trebam li sam pripremiti tekstove i slike?', a: 'Ne morate. U paketu Forum pišemo tekstove umjesto vas, a možemo preporučiti i fotografa. Ako već imate materijale, rado ćemo ih iskoristiti.' },
  { q: 'Što je AI optimizacija?', a: 'Sve više ljudi umjesto klasične pretrage pita ChatGPT, Googleove AI preglede ili druge asistente gdje jesti, spavati ili koga zvati. AI optimizacijom slažemo stranicu, strukturirane podatke i Google poslovni profil tako da ti alati jasno razumiju tko ste, gdje ste i što nudite, pa vas lakše preporuče.' },
  { q: 'Pomažete li da me klijenti pronađu na Googleu?', a: 'Da. Svaku stranicu radimo s osnovnim SEO-om, a sređujemo i Google poslovni profil: kategorije, radno vrijeme, fotografije, recenzije i objave, da se pojavite na Google Mapsu kad vas netko traži.' },
  { q: 'Čija je domena i stranica nakon izrade?', a: 'Vaša. Domena se registrira na vaše ime, a stranicu možete preseliti kod bilo kojeg drugog pružatelja usluga.' },
  { q: 'Mogu li sam mijenjati sadržaj?', a: 'Da. Ako želite sami mijenjati tekstove, cijene ili novosti, postavit ćemo jednostavan sustav i pokazati vam kako ga koristiti. Ako ne želite, izmjene radimo mi.' },
  { q: 'Radite li i za klijente izvan Zadra?', a: 'Da. Sastanke možemo održati i online, a stranice radimo za klijente iz cijele Hrvatske.' },
];

const home = 'https://idassa.digital/';
const offer = (name: string, price: number, description: string) => ({
  '@type': 'Offer', name, price, priceCurrency: 'EUR', description, url: `${home}#paketi`,
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${home}#studio`,
      name: site.name,
      alternateName: site.tradeName,
      description: 'Izrada web stranica, Google (SEO) optimizacija, AI optimizacija i digitalni marketing za smještajne objekte, obrte i male tvrtke u cijeloj Hrvatskoj.',
      url: home,
      logo: `${home}assets/icon-512.png`,
      image: `${home}assets/og-image.png`,
      email: site.email,
      telephone: site.phone,
      address: { '@type': 'PostalAddress', postalCode: '23000', addressLocality: 'Zadar', addressCountry: 'HR' },
      areaServed: { '@type': 'Country', name: 'Hrvatska' },
      availableLanguage: ['hr', 'en'],
      priceRange: '390 € – 790 €',
      knowsAbout: ['izrada web stranica', 'web dizajn', 'SEO', 'Google poslovni profil', 'AI optimizacija', 'digitalni marketing', 'web stranice za apartmane'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Paketi izrade web stranica',
        itemListElement: [
          offer('Portus', 390, 'Stranica na jednoj stranici, prilagođena mobitelu, registracija domene, prijevod na 3 jezika, galerija do 12 fotografija.'),
          offer('Forum', 790, 'Do 6 podstranica, pisanje tekstova, osnovni SEO i Google profil, obrazac za upite, prijevod na 7 jezika, galerija do 24 fotografije.'),
        ],
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${home}#pitanja`,
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<Base
  home
  title="Izrada web stranica, SEO i AI optimizacija | idassa.digital"
  description="Izrađujemo brze web stranice za apartmane, obrte i male tvrtke diljem Hrvatske, uz Google (SEO) i AI optimizaciju. Jasne cijene od 390 €, gotovo za dva tjedna."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<div class={site.heroImage ? "hero has-photo" : "hero"} data-parallax-root>
  <div class="hero-bg" aria-hidden="true">
    {site.heroImage && <img class="p-photo" data-speed="0.3" src={site.heroImage} srcset={`${site.heroImageSmall} 1000w, ${site.heroImage} 2000w`} sizes="100vw" alt="" fetchpriority="high" />}
    <svg class="p-sea" viewBox="0 0 1200 160" preserveAspectRatio="none">
      <path d="M0 40 Q 150 10 300 40 T 600 40 T 900 40 T 1200 40" />
      <path d="M0 80 Q 150 50 300 80 T 600 80 T 900 80 T 1200 80" />
      <path d="M0 120 Q 150 90 300 120 T 600 120 T 900 120 T 1200 120" />
    </svg>
  </div>
  <div class="hero-text">
    <p class="eyebrow">Web studio · Zadar</p>
    <h1>Vaš posao, <em>dostojno</em> predstavljen na webu.</h1>
    <p class="lead">Izrađujemo pouzdane i pregledne web stranice za smještajne objekte, obrte, male tvrtke i slično. Jasno, brzo i bez skrivenih troškova.</p>
    <div class="cta-row">
      <a class="btn sun" href="#kontakt">Zatraži ponudu</a>
      <a class="btn ghost" href="#paketi">Pogledaj pakete</a>
    </div>
  </div>

  <a class="browser showcase" href="#radovi" aria-label="Pogledaj naše radove">
    <div class="bar">
      <div class="dots"><i></i><i></i><i></i></div>
      <div class="url">https://<b data-show-url>{shots[0].domain}</b></div>
    </div>
    <div class="shots">
      {shots.map((w, i) => (
        <img src={w.image} alt={`Stranica ${w.name}`} width="1280" height="800" data-domain={w.domain} class={i === 0 ? 'on' : ''} loading={i === 0 ? 'eager' : 'lazy'} />
      ))}
    </div>
    <span class="show-tag">Naš rad</span>
  </a>
</div>

<section aria-labelledby="ime">
  <div class="story">
    <h2 class="name" id="ime"><span>idassa</span><span class="sun"></span><span class="w2">digital</span></h2>
    <p>Idassa je najstarije zapisano ime Zadra. <span>Grad koji tri tisuće godina dočekuje ljude s mora danas vas dočekuje na webu. Od tog imena krenuli smo i mi.</span></p>
  </div>
</section>

<section id="usluge" aria-labelledby="usluge-naslov">
  <div class="sec-head">
    <h2 id="usluge-naslov">Što radimo</h2>
    <p>Od prvog razgovora do stranice koja radi za vas. Vi se bavite svojim poslom, a web prepustite nama.</p>
  </div>
  <div class="services">
    <article>
      <h3>Web stranice</h3>
      <p>Pregledna stranica koja ulijeva povjerenje, dobro izgleda na mobitelu i učitava se u sekundi.</p>
      <ul><li>Dizajn</li><li>Izrada</li><li>Tekstovi</li><li>Više jezika</li></ul>
    </article>
    <article>
      <h3>Google i SEO</h3>
      <p>Da vas klijenti pronađu na Googleu i Google Mapsu: optimizirana stranica i sređen Google poslovni profil s recenzijama i fotografijama.</p>
      <ul><li>SEO</li><li>Google profil</li><li>Google Maps</li></ul>
    </article>
    <article>
      <h3>AI optimizacija</h3>
      <p>Sve više ljudi pita ChatGPT i Googleove AI preglede koga zvati. Slažemo stranicu i podatke tako da vas AI alati razumiju i preporuče.</p>
      <ul><li>ChatGPT</li><li>AI pregledi</li><li>Strukturirani podaci</li></ul>
    </article>
    <article>
      <h3>Održavanje i marketing</h3>
      <p>Brinemo da stranica radi i da je sigurna, a pomažemo i s objavama, društvenim mrežama i oglasima.</p>
      <ul><li>Hosting</li><li>Održavanje</li><li>Društvene mreže</li></ul>
    </article>
  </div>
</section>

<section id="radovi" aria-labelledby="radovi-naslov">
  <div class="sec-head">
    <h2 id="radovi-naslov">Naši radovi</h2>
    <p>Stranice koje smo napravili i koje rade svaki dan.</p>
  </div>
  <div class="works">
    {portfolio.map((w) => (
      <article class="work">
        <a class="work-shot" href={w.url} target="_blank" rel="noopener" aria-label={`Otvori ${w.domain}`} style={`--w-accent:${w.accent}`}>
          <div class="bar">
            <div class="dots"><i></i><i></i><i></i></div>
            <div class="url">https://<b>{w.domain}</b></div>
          </div>
          {w.image ? (
            <img class="work-img" src={w.image} alt={`Naslovnica stranice ${w.domain}`} loading="lazy" width="1280" height="800" />
          ) : (
            <div class="work-hero">
              <span class="work-type">{w.type}</span>
              <span class="work-headline">{w.headline}</span>
            </div>
          )}
        </a>
        <div class="work-body">
          <h3>{w.name}</h3>
          <p>{w.description}</p>
          <ul>{w.tags.map((t) => <li>{t}</li>)}</ul>
          <a class="work-link" href={w.url} target="_blank" rel="noopener">{w.domain} ↗</a>
        </div>
      </article>
    ))}
  </div>
</section>

<section aria-labelledby="proces">
  <div class="sec-head">
    <h2 id="proces">Kako to ide</h2>
    <p>Jednostavna stranica može biti gotova za dva tjedna.</p>
  </div>
  <ol class="steps">
    <li class="step"><div class="day">1. dan</div><h3>Razgovor</h3><p>Upoznamo vaš posao, klijente i što vam stranica treba.</p></li>
    <li class="step"><div class="day">3. dan</div><h3>Prijedlog dizajna</h3><p>Dobijete izgled stranice i kažete što mijenjati.</p></li>
    <li class="step"><div class="day">5. do 12. dan</div><h3>Izrada</h3><p>Slažemo stranicu, tekstove i slike te sve testiramo na mobitelu.</p></li>
    <li class="step"><div class="day">14. dan</div><h3>Objava</h3><p>Stranica je na vašoj domeni, a mi ostajemo uz vas.</p></li>
  </ol>
</section>

<section id="paketi" aria-labelledby="paketi-naslov">
  <div class="sec-head">
    <h2 id="paketi-naslov">Paketi</h2>
    <p>Jasne cijene unaprijed. Ako vam treba nešto između, složimo ponudu po mjeri.</p>
  </div>
  <div class="plans">
    <div class="plan">
      <h3>Portus</h3>
      <div class="price">390 €<small> jednokratno</small></div>
      <ul>
        <li>Stranica na jednoj stranici</li>
        <li>Kontakt, karta i radno vrijeme</li>
        <li>Prilagođeno mobitelu</li>
        <li>Registracija domene</li>
        <li>Prijevod na 3 jezika</li>
        <li>Fotogalerija do 12 fotografija</li>
      </ul>
      <a class="btn ghost" href="#kontakt">Odaberi Portus</a>
    </div>
    <div class="plan featured">
      <span class="badge">Najčešći izbor</span>
      <h3>Forum</h3>
      <div class="price">790 €<small> jednokratno</small></div>
      <ul>
        <li>Do 6 podstranica</li>
        <li>Pisanje tekstova</li>
        <li>Osnovni SEO i Google profil</li>
        <li>Obrazac za upite</li>
        <li>Prijevod na 7 jezika</li>
        <li>Fotogalerija do 24 fotografije</li>
      </ul>
      <a class="btn sun" href="#kontakt">Odaberi Forum</a>
    </div>
  </div>
  <p class="fine">Sve cijene su konačne, PDV je uključen. Održavanje i hosting od 25 € mjesečno.</p>
</section>

<section aria-labelledby="zasto">
  <div class="sec-head"><h2 id="zasto">Zašto idassa.digital</h2></div>
  <div class="why">
    <div><span class="ic" aria-hidden="true">1s</span><div><h3>Brzo se učitava</h3><p>Spore stranice gube posjetitelje. Naše se učitavaju za manje od sekunde.</p></div></div>
    <div><span class="ic" aria-hidden="true">hr</span><div><h3>Lokalno, iz Zadra</h3><p>Razgovaramo vašim jezikom, a ne žargonom. Možemo se naći i uživo.</p></div></div>
    <div><span class="ic" aria-hidden="true">€</span><div><h3>Bez skrivenih troškova</h3><p>Cijenu znate prije početka. Domena i stranica su vaše.</p></div></div>
    <div><span class="ic" aria-hidden="true">✓</span><div><h3>Dugoročno uz vas</h3><p>Nakon objave ostajemo dostupni za izmjene, pitanja i savjete.</p></div></div>
  </div>
</section>

<section id="pitanja" aria-labelledby="pitanja-naslov">
  <div class="sec-head"><h2 id="pitanja-naslov">Česta pitanja</h2></div>
  <div class="faq">
    {faq.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<div class="contact" id="kontakt">
  <div class="contact-intro">
    <h2>Razgovarajmo o vašoj <em>stranici.</em></h2>
    <p>Napišite nam ukratko čime se bavite i što vam treba. Javljamo se u roku od jednog radnog dana.</p>
    <div class="channels">
      <div class="channel"><span class="lbl">E-mail</span><a href={`mailto:${site.email}`}>{site.email}</a></div>
      <div class="channel"><span class="lbl">Telefon</span><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></div>
    </div>
  </div>
  <form class="cform" method="post" action="/api/kontakt" data-contact-form novalidate>
    <div class="field">
      <label for="cf-ime">Ime i prezime</label>
      <input id="cf-ime" name="ime" type="text" autocomplete="name" required maxlength="100" />
    </div>
    <div class="row">
      <div class="field">
        <label for="cf-email">E-mail</label>
        <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="200" />
      </div>
      <div class="field">
        <label for="cf-tel">Telefon <span>(nije obavezno)</span></label>
        <input id="cf-tel" name="telefon" type="tel" autocomplete="tel" maxlength="40" />
      </div>
    </div>
    <div class="field">
      <label for="cf-paket">Paket</label>
      <select id="cf-paket" name="paket">
        <option value="Nisam siguran">Nisam siguran, savjetujte me</option>
        <option value="Portus">Portus (390 €)</option>
        <option value="Forum">Forum (790 €)</option>
      </select>
    </div>
    <div class="field">
      <label for="cf-poruka">Poruka</label>
      <textarea id="cf-poruka" name="poruka" rows="5" required maxlength="5000" placeholder="Npr. apartman u Zadru, trebam stranicu na 3 jezika s galerijom."></textarea>
    </div>
    <div class="hp" aria-hidden="true">
      <label for="cf-web">Web stranica</label>
      <input id="cf-web" name="web" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="t" value="" data-started />
    <p class="fine-print">Slanjem pristajete da vaše podatke koristimo samo za odgovor na upit. <a href="/politika-privatnosti">Politika privatnosti</a></p>
    <button class="btn sun" type="submit">Pošalji upit</button>
    <p class="status" role="status" aria-live="polite" data-status></p>
  </form>
</div>
<script>
  const root = document.querySelector('[data-parallax-root]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (root && !reduce.matches) {
    const layers = Array.from(root.querySelectorAll<HTMLElement>('[data-speed]'));
    let ticking = false;
    const update = () => {
      const y = Math.min(window.scrollY, window.innerHeight * 1.2);
      for (const el of layers) {
        const speed = parseFloat(el.dataset.speed || '0');
        el.style.transform = `translate3d(0, ${(y * speed).toFixed(1)}px, 0)`;
      }
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  }

  const show = document.querySelector('.showcase');
  if (show && !reduce.matches) {
    const imgs = Array.from(show.querySelectorAll<HTMLImageElement>('.shots img'));
    const url = show.querySelector('[data-show-url]');
    let i = 0;
    if (imgs.length > 1) setInterval(() => {
      if (document.hidden) return;
      imgs[i].classList.remove('on');
      i = (i + 1) % imgs.length;
      imgs[i].classList.add('on');
      if (url) url.textContent = imgs[i].dataset.domain || '';
    }, 4000);
  }

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const started = form.querySelector<HTMLInputElement>('[data-started]');
    if (started) started.value = String(Date.now());
    const show = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.className = 'status ' + (ok ? 'ok' : 'err');
    };
    const q = new URLSearchParams(location.search);
    if (q.get('poslano')) show('Hvala! Poruka je poslana, javljamo se u roku od jednog radnog dana.', true);
    if (q.get('greska')) show('Poruka nije poslana. Provjerite polja ili nam pišite na hello@idassa.digital.', false);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      show('Šaljem…', true);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await res.json().catch(() => ({ ok: false, message: '' }));
        if (res.ok && data.ok) {
          form.reset();
          (window as any).gtag?.('event', 'generate_lead', { form: 'kontakt' });
          if (started) started.value = String(Date.now());
          show(data.message || 'Hvala! Poruka je poslana.', true);
        } else {
          show(data.message || 'Poruka nije poslana. Pišite nam na hello@idassa.digital.', false);
        }
      } catch {
        show('Nema veze s poslužiteljem. Pokušajte ponovno ili nam pišite na hello@idassa.digital.', false);
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
</Base>
