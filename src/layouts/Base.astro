---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  home?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  published?: Date;
  modified?: Date;
}
const { title, description, noindex = false, home = false, ogType = 'website', ogImage: ogImagePath = '/assets/og-image.png', ogImageAlt = 'idassa.digital, izrada web stranica, SEO i AI optimizacija', published, modified } = Astro.props;
const inBlog = Astro.url.pathname.startsWith('/blog');
const pre = home ? '' : '/';
const menuItems = [
  { label: 'Usluge', href: `${pre}#usluge` },
  { label: 'Radovi', href: `${pre}#radovi` },
  { label: 'Kako radimo', href: `${pre}#proces` },
  { label: 'Paketi i cijene', href: `${pre}#paketi` },
  { label: 'Zašto mi', href: `${pre}#zasto` },
  { label: 'Česta pitanja', href: `${pre}#pitanja` },
  { label: 'Blog', href: '/blog/', current: inBlog },
  { label: 'Kontakt', href: `${pre}#kontakt` },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImagePath, Astro.site);
---
<!doctype html>
<html lang="hr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {(noindex || !site.isPublic) && <meta name="robots" content="noindex, nofollow">}
  <meta name="color-scheme" content="only light">
  <meta name="theme-color" content="#F8F3F0">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials">
  <link rel="preload" href="/fonts/archivo-black-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/archivo-latin-400.woff2" as="font" type="font/woff2" crossorigin>
  <meta property="og:type" content={ogType}>
  <meta property="og:locale" content="hr_HR">
  <meta property="og:site_name" content={site.name}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={ogImageAlt}>
  {published && <meta property="article:published_time" content={published.toISOString()}>}
  {modified && <meta property="article:modified_time" content={modified.toISOString()}>}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="alternate" type="application/rss+xml" title="idassa.digital blog" href="/blog/rss.xml">
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#sadrzaj">Preskoči na sadržaj</a>
  <div class="wrap">
    <header class="site">
      <a class="logo" href="/" aria-label={`${site.name}, početna`}><Logo /></a>
      <nav aria-label="Glavna navigacija">
        {home ? (
          <>
            <a class="hide-sm" href="#usluge">Usluge</a>
            <a class="hide-sm" href="#radovi">Radovi</a>
            <a class="hide-sm" href="#paketi">Paketi</a>
            <a class="hide-sm" href="#pitanja">Pitanja</a>
            <a class="hide-sm" href="/blog/">Blog</a>
            <a class="btn" href="#kontakt">Kontakt</a>
          </>
        ) : (
          <>
            <a class="hide-sm" href="/#usluge">Usluge</a>
            <a class="hide-sm" href="/#paketi">Paketi</a>
            <a href="/blog/" aria-current={inBlog ? 'page' : undefined}>Blog</a>
            <a class="btn" href="/#kontakt">Kontakt</a>
          </>
        )}
      </nav>
      <div class="menu">
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-panel" aria-label="Otvori izbornik">
          <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
        <div class="menu-panel" id="menu-panel" hidden>
          <p class="menu-title">Rubrike</p>
          <ul>
            {menuItems.map((m) => (
              <li><a href={m.href} aria-current={m.current ? 'page' : undefined}>{m.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </header>

    <main id="sadrzaj" class={home ? undefined : 'doc'}>
      <slot />
    </main>

    <footer class="site">
      <div class="legal">
        <a class="logo" href="/" aria-label={site.name}><Logo /></a>
        {site.owner
          ? <span>{site.tradeName}, obrt za računalne usluge, vl. {site.owner}</span>
          : <span>{site.tradeName} · {site.city}</span>}
        {site.address && <span>{site.address}{site.oib && ` · OIB: ${site.oib}`}</span>}
        <span>© {site.year} {site.name}</span>
      </div>
      <div class="links">
        <a href="/blog/">Blog</a>
        <a href="/politika-privatnosti/">Politika privatnosti</a>
        {site.gaId && <a href="/politika-privatnosti/#kolacici" data-cookie-settings>Postavke kolačića</a>}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </footer>
  </div>
  {site.gaId && (
    <>
      <div class="cookies" id="kolacici-traka" role="dialog" aria-label="Kolačići" hidden>
        <p>Koristimo Google Analytics da vidimo koliko ljudi posjećuje stranicu i što ih zanima. Kolačiće postavljamo samo ako pristanete. <a href="/politika-privatnosti/#kolacici">Više o tome</a></p>
        <div class="cookies-btns">
          <button class="btn ghost" type="button" data-consent="ne">Odbijam</button>
          <button class="btn" type="button" data-consent="da">Prihvaćam</button>
        </div>
      </div>
      <script is:inline define:vars={{ gaId: site.gaId }}>
        (function () {
          var KEY = 'idassa-kolacici';
          function get() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
          function set(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
          function load() {
            if (window.__gaLoaded) return;
            window.__gaLoaded = true;
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            var gtm = gaId.indexOf('GTM-') === 0;
            if (!gtm) window.gtag('config', gaId);
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/' + (gtm ? 'gtm.js' : 'gtag/js') + '?id=' + gaId;
            document.head.appendChild(s);
          }
          function clear() {
            document.cookie.split(';').forEach(function (c) {
              var n = c.split('=')[0].trim();
              if (n.indexOf('_ga') === 0 || n === '_gid') {
                ['', '; domain=.' + location.hostname, '; domain=' + location.hostname].forEach(function (d) {
                  document.cookie = n + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + d;
                });
              }
            });
          }
          function init() {
            var bar = document.getElementById('kolacici-traka');
            var choice = get();
            if (choice === 'da') load();
            else if (!choice) bar.hidden = false;
            bar.addEventListener('click', function (e) {
              var v = e.target.getAttribute && e.target.getAttribute('data-consent');
              if (!v) return;
              set(v);
              bar.hidden = true;
              if (v === 'da') load();
              else if (window.__gaLoaded) { clear(); location.reload(); }
              else clear();
            });
            document.querySelectorAll('[data-cookie-settings]').forEach(function (a) {
              a.addEventListener('click', function (e) { e.preventDefault(); bar.hidden = false; });
            });
          }
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
          else init();
        })();
      </script>
    </>
  )}
<script is:inline>
  (() => {
    const btn = document.querySelector('.menu-btn');
    const panel = document.getElementById('menu-panel');
    if (!btn || !panel) return;
    const set = (open) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Zatvori izbornik' : 'Otvori izbornik');
      panel.hidden = !open;
    };
    btn.addEventListener('click', (e) => { e.stopPropagation(); set(panel.hidden); });
    panel.addEventListener('click', (e) => { if (e.target.closest('a')) set(false); });
    document.addEventListener('click', (e) => { if (!panel.hidden && !e.target.closest('.menu')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { set(false); btn.focus(); } });
  })();
</script>
</body>
</html>
